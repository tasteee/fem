{
	"name": "fem-site",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "npm run prepare-sources",
		"dev": "vite",
		"prepare-sources": "npm run icons -w @tasteee/fem && npm run manifest -w @tasteee/fem && npm run manifest -w @tasteee/fem-media",
		"prebuild:demos": "npm run prepare-sources",
		"build:demos": "vite build",
		"pretypecheck": "npm run prepare-sources",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@tasteee/fem": "*",
		"@tasteee/fem-media": "*"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	}
}
