{
	"name": "pianist",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "npm run prepare-sources",
		"dev": "vite",
		"prepare-sources": "npm run icons -w @tasteee/fem && npm run manifest -w @tasteee/fem",
		"prebuild": "npm run prepare-sources",
		"build": "vite build",
		"pretypecheck": "npm run prepare-sources",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"layouts": "vite-node scripts/print-layouts.ts"
	},
	"dependencies": {
		"@tasteee/fem": "*",
		"@tasteee/midi-piano": "*",
		"smplr": "^1.1.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.9"
	}
}
