{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"types": [
			"vite/client",
			"svelte"
		],
		"paths": {
			"@tasteee/fem": [
				"../../packages/fem/src/index.ts"
			],
			"@tasteee/fem/icons": [
				"../../packages/fem/src/icons/index.ts"
			],
			"@tasteee/fem/foundation": [
				"../../packages/fem/src/foundation/index.ts"
			],
			"@tasteee/fem/custom-elements.json": [
				"../../packages/fem/custom-elements.json"
			],
			"@tasteee/fem-media": [
				"../../packages/fem-media/src/index.ts"
			],
			"@tasteee/fem-media/custom-elements.json": [
				"../../packages/fem-media/custom-elements.json"
			]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "atomico"
	},
	"include": [
		"src",
		"../../packages/fem/types/fem-svelte.d.ts",
		"../../packages/fem-media/types/fem-svelte.d.ts"
	]
}
