{
	"name": "femes",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "npm run prepare-sources",
		"dev": "vite",
		"prepare-sources": "npm run icons -w @tasteee/fem && npm run manifest -w @tasteee/fem && npm run manifest -w @tasteee/fem-media",
		"prebuild": "npm run prepare-sources",
		"build": "vite build && npm run build:server",
		"pretypecheck": "npm run prepare-sources",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json",
		"build:server": "esbuild server/worker.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=dist/_worker.js --loader:.sql=text",
		"preview": "wrangler pages dev dist --port 5201",
		"db:migrate:local": "wrangler d1 migrations apply femes-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply femes-db --remote"
	},
	"dependencies": {
		"@breezystack/lamejs": "1.2.7",
		"@tasteee/fem": "*",
		"@tasteee/fem-media": "*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"esbuild": "^0.24.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"wrangler": "^4.152.0"
	}
}
