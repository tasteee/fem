{
	"name": "@tasteee/fem",
	"version": "0.1.0",
	"description": "A flat, premium web component design system.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"src/tokens.css",
		"src/palette-zest.css",
		"types",
		"custom-elements.json",
		"vscode.html-custom-data.json"
	],
	"main": "./dist/fem.js",
	"module": "./dist/fem.js",
	"sideEffects": [
		"./dist/fem.js",
		"./src/index.ts",
		"**/*.css"
	],
	"exports": {
		".": "./dist/fem.js",
		"./icons": "./dist/icons.js",
		"./tokens.css": "./src/tokens.css",
		"./palette-zest.css": "./src/palette-zest.css",
		"./jsx": {
			"types": "./types/fem-jsx.d.ts"
		},
		"./react": {
			"types": "./types/fem-react.d.ts"
		},
		"./svelte": {
			"types": "./types/fem-svelte.d.ts"
		},
		"./custom-elements.json": "./custom-elements.json",
		"./vscode.html-custom-data.json": "./vscode.html-custom-data.json",
		"./foundation": "./dist/foundation.js"
	},
	"scripts": {
		"icons": "node scripts/build-icons.mjs",
		"manifest": "node scripts/build-manifest.mjs",
		"prebuild": "npm run icons && npm run manifest",
		"build": "vite build",
		"pretypecheck": "npm run icons && npm run manifest",
		"typecheck": "tsc --noEmit",
		"pretest": "npm run icons && npm run manifest",
		"test": "vitest run"
	},
	"dependencies": {
		"atomico": "^2.2.0"
	},
	"devDependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"@vitest/browser": "^2.1.9",
		"axe-core": "^4.14.0",
		"playwright": "^1.64.1",
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"vitest": "^2.1.9"
	},
	"customElements": "custom-elements.json",
	"repository": {
		"type": "git",
		"url": "https://github.com/tasteee/fem.git",
		"directory": "packages/fem"
	}
}
