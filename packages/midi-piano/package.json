{
	"name": "@tasteee/midi-piano",
	"version": "0.1.0",
	"description": "A Splendid Grand Piano with a tiny API: piano.play('C4'). Wraps smplr and the Web Audio setup.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/midi-piano.js",
	"module": "./dist/midi-piano.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/midi-piano.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tasteee/fem.git",
		"directory": "packages/midi-piano"
	},
	"scripts": {
		"build": "vite build && tsc --emitDeclarationOnly --noEmit false --declaration --outDir dist",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"smplr": "^1.1.0"
	},
	"devDependencies": {
		"smplr": "^1.1.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	}
}
