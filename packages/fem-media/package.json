{
	"name": "@tasteee/fem-media",
	"version": "0.1.0",
	"description": "Music and media components for fem: an audio engine, player bar, now playing view, and track rows.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"types",
		"custom-elements.json",
		"vscode.html-custom-data.json"
	],
	"main": "./dist/fem-media.js",
	"module": "./dist/fem-media.js",
	"sideEffects": [
		"./dist/fem-media.js",
		"./src/index.ts",
		"**/*.css"
	],
	"customElements": "custom-elements.json",
	"exports": {
		".": "./dist/fem-media.js",
		"./jsx": {
			"types": "./types/fem-jsx.d.ts"
		},
		"./react": {
			"types": "./types/fem-react.d.ts"
		},
		"./svelte": {
			"types": "./types/fem-svelte.d.ts"
		},
		"./custom-elements.json": "./custom-elements.json",
		"./vscode.html-custom-data.json": "./vscode.html-custom-data.json"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tasteee/fem.git",
		"directory": "packages/fem-media"
	},
	"scripts": {
		"manifest": "node ../fem/scripts/build-manifest.mjs",
		"prebuild": "npm run manifest",
		"build": "vite build",
		"pretypecheck": "npm run manifest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@tasteee/fem": "^0.1.0",
		"atomico": "^2.2.0"
	},
	"devDependencies": {
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	}
}
