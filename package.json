{
	"name": "@tasteee/fem",
	"version": "0.1.0",
	"description": "A flat, premium web component design system.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"src/tokens.css"
	],
	"main": "./dist/fem.js",
	"module": "./dist/fem.js",
	"sideEffects": ["./dist/fem.js", "./src/index.ts", "**/*.css"],
	"exports": {
		".": "./dist/fem.js",
		"./icons": "./dist/icons.js",
		"./tokens.css": "./src/tokens.css"
	},
	"scripts": {
		"icons": "node scripts/build-icons.mjs",
		"predev": "npm run icons",
		"dev": "vite",
		"prebuild": "npm run icons",
		"build": "vite build",
		"pretypecheck": "npm run icons",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write ."
	},
	"dependencies": {
		"atomico": "^2.2.0"
	},
	"devDependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"prettier": "^3.3.0",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	}
}
