{
	"name": "@tasteee/fem",
	"version": "0.1.0",
	"description": "A flat, premium web component design system.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist",
		"src/tokens.css",
		"types",
		"custom-elements.json",
		"vscode.html-custom-data.json"
	],
	"main": "./dist/fem.js",
	"module": "./dist/fem.js",
	"sideEffects": [
		"./dist/fem.js",
		"./src/index.ts",
		"**/*.css"
	],
	"exports": {
		".": "./dist/fem.js",
		"./icons": "./dist/icons.js",
		"./tokens.css": "./src/tokens.css",
		"./jsx": {
			"types": "./types/fem-jsx.d.ts"
		},
		"./react": {
			"types": "./types/fem-react.d.ts"
		},
		"./svelte": {
			"types": "./types/fem-svelte.d.ts"
		},
		"./custom-elements.json": "./custom-elements.json",
		"./vscode.html-custom-data.json": "./vscode.html-custom-data.json"
	},
	"scripts": {
		"icons": "node scripts/build-icons.mjs",
		"manifest": "node scripts/build-manifest.mjs",
		"predev": "npm run icons",
		"dev": "vite",
		"prebuild": "npm run icons && npm run manifest",
		"build": "vite build",
		"prebuild:demos": "npm run icons",
		"build:demos": "vite build --config vite.demos.config.ts",
		"pretypecheck": "npm run icons && npm run manifest",
		"typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write ."
	},
	"dependencies": {
		"atomico": "^2.2.0"
	},
	"devDependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"prettier": "^3.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^5.6.0",
		"vite": "^5.4.0"
	},
	"customElements": "custom-elements.json"
}
